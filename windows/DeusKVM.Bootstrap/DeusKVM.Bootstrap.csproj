<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DeusKVM</AssemblyName>
    <RootNamespace>DeusKVM.Bootstrap</RootNamespace>
    <Product>DeusKVM Companion</Product>
    <Title>DeusKVM Companion</Title>
    <Description>DeusKVM companion installer and launcher</Description>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>../DeusKVM.Companion/app.manifest</ApplicationManifest>
    <ApplicationIcon>../DeusKVM.Companion/AppIcon.ico</ApplicationIcon>
    <DebugType>None</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <EmbeddedResource Include="$(BundleArchive)" LogicalName="DeusKVM.Payload.zip" Condition="'$(BundleArchive)' != ''" />
    <EmbeddedResource Include="$(BundleHash)" LogicalName="DeusKVM.Payload.sha256" Condition="'$(BundleHash)' != ''" />
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(BundleArchive)') Or !Exists('$(BundleHash)')" Text="Build the launcher through windows/publish.sh so it contains a verified payload." />
  </Target>
</Project>
